{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://diccionario-nasa-liart.vercel.app",
        "EXPO_PUBLIC_SEED_BASE_URL": ""
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://diccionario-nasa-liart.vercel.app",
        "EXPO_PUBLIC_SEED_BASE_URL": ""
      }
    }
  },
  "submit": {
    "production": {}
  }
}