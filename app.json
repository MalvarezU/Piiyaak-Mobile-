{
  "expo": {
    "name": "Piiyaak",
    "slug": "piiyaak",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "piiyaak",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#faf7f0"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.piiyaak.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#faf7f0"
      },
      "package": "com.piiyaak.app"
    },
    "plugins": [
      "expo-router",
      "react-native-zip-archive",
      "expo-asset",
      "expo-secure-store",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6996fb58-882e-42e4-af3e-d36d6b5833d6"
      }
    },
    "owner": "marioalvarezco"
  }
}
